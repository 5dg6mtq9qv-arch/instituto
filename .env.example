DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DB_NAME=instituto
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Moodle (guardar el token real únicamente en .env)
MOODLE_BASE_URL=https://aula.felixiot.site
MOODLE_TOKEN=
MOODLE_TIMEOUT=20
# Ajustar a los identificadores de categoría y roles de la instancia Moodle.
MOODLE_CATEGORY_ID=1
MOODLE_TEACHER_ROLE_ID=3
MOODLE_STUDENT_ROLE_ID=5
# Clave temporal común de las cuentas nuevas. Moodle exigirá cambiarla al entrar.
MOODLE_INITIAL_PASSWORD=

# Correo provisional de alumnos y docentes que no tienen correo registrado.
MOODLE_FALLBACK_EMAIL_DOMAIN=felixiot.site
